  clickCount           Int          @default(0)
  hoverCount           Int          @default(0)
  averageHesitationMs  Int          @default(0)
  averageFrictionScore Float        @default(0.0)
  attentionWeight      Float        @default(0.0)
  cognitiveDensity     Float        @default(0.0)
  createdAt            DateTime     @default(now())
}

model SwarmReplayEvent {
  id                 String           @id @default(uuid())
  personaExecutionId String
  execution          PersonaExecution @relation(fields: [personaExecutionId], references: [id], onDelete: Cascade)
  stepIndex          Int
  timestampMs        Int
  eventType          String // "HOVER", "CLICK", "INPUT", etc.
  targetSelector     String?
  coordinates        Json? // { x, y }
  cognitiveLoad      Float
  confidence         Float
  description        String
  createdAt          DateTime         @default(now())
}

model WorkflowForecast {
  id                   String   @id @default(uuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowPath         String
  status               String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  stabilityScore       Float    @default(0.0) // 0.0 to 1.0 (overall workflow health prediction)
  completionRate       Float    @default(0.0) // predicted completion rate
  averageFriction      Float    @default(0.0) // predicted average friction
  failureClusterPoints Json // Array of selectors where failures are expected
  riskLevel            String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  createdAt            DateTime @default(now())

  riskSignals            PredictiveRiskSignal[]
  survivabilityForecasts SurvivabilityForecast[]
  abandonmentPredictions AbandonmentPrediction[]
  timelineEvents         PredictiveTimelineEvent[]
}

model PredictiveRiskSignal {
  id                  String           @id @default(uuid())
  workflowForecastId  String
  forecast            WorkflowForecast @relation(fields: [workflowForecastId], references: [id], onDelete: Cascade)
  stepIndex           Int
  riskType            String // "WORKFLOW_COLLAPSE", "ONBOARDING_FAILURE", "CTA_WEAKNESS", "NAVIGATION_FAILURE", "FRICTION_ESCALATION", "COGNITIVE_OVERLOAD", "MOBILE_FAILURE", "PERSONA_FAILURE"
  confidenceScore     Float // 0.0 to 1.0
  severity            String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  targetSelector      String?
  contributingSignals Json // list of strings
  evidenceNotes       String
  historicalBasis     String
  createdAt           DateTime         @default(now())
}

model RegressionEvent {
  id                   String              @id @default(uuid())
  projectId            String
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowPath         String
  metricName           String // "COMPLETION_RATE" | "FRICTION_SCORE" | "COGNITIVE_LOAD" | "STEPS_TO_COMPLETE"
  baseValue            Float
  forecastedValue      Float
  driftPercentage      Float
  severity             String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  contributingFactors  Json // list of factors
  historicalBaselineId String?
  baseline             HistoricalBaseline? @relation(fields: [historicalBaselineId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
}

model HistoricalBaseline {
  id                   String   @id @default(uuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  workflowPath         String
