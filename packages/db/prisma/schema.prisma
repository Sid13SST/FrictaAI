generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  projects  Project[]
  platformUsage PlatformUsage?
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  projectName String
  websiteUrl  String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  sessions    WorkflowSession[]
}

model WorkflowSession {
  id           String   @id @default(uuid())
  projectId    String
  goal         String?
  persona      String?
  status       String   @default("PENDING")
  queueJobId   String?
  stepCount    Int      @default(0)
  model        String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime @default(now())

  project      Project            @relation(fields: [projectId], references: [id])
  reports      UXReport[]
  interactions InteractionEvent[]
  screenshots  Screenshot[]
  thoughts     AgentThought[]
  actions      AgentAction[]
  signals      UXSignal[]
  recommendations UXRecommendation[]
  scores       UXScore[]
  metrics      WorkflowMetrics?
}

model AgentThought {
  id                String   @id @default(uuid())
  workflowSessionId String
  thought           String
  stepNumber        Int
  timestamp         DateTime @default(now())

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id])
}

model AgentAction {
  id                String   @id @default(uuid())
  workflowSessionId String
  action            String
  target            String
  value             String?
  status            String   @default("pending")
  stepNumber        Int
  errorMessage      String?
  timestamp         DateTime @default(now())

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id])
}

model InteractionEvent {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  target    String
  metadata  Json?
  timestamp DateTime @default(now())

  session   WorkflowSession @relation(fields: [sessionId], references: [id])
}

model Screenshot {
  id        String   @id @default(uuid())
  sessionId String
  path      String
  timestamp DateTime @default(now())

  session   WorkflowSession @relation(fields: [sessionId], references: [id])
}

model UXReport {
  id         String   @id @default(uuid())
  sessionId  String
  summary    String
  score      Int
  createdAt  DateTime @default(now())
  
  session    WorkflowSession @relation(fields: [sessionId], references: [id])
}

model UXSignal {
  id                String   @id @default(uuid())
  workflowSessionId String
  signalType        String
  severity          String
  metadata          Json?
  timestamp         DateTime @default(now())

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model UXRecommendation {
  id                String   @id @default(uuid())
  workflowSessionId String
  title             String
  description       String
  evidence          String
  severity          String

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model UXScore {
  id                String   @id @default(uuid())
  workflowSessionId String
  clarityScore      Float
  efficiencyScore   Float
  smoothnessScore   Float
  overallScore      Float

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model WorkflowMetrics {
  id                String   @id @default(uuid())
  workflowSessionId String   @unique
  duration          Int?
  retryCount        Int      @default(0)
  tokenUsage        Int      @default(0)
  completionStatus  String

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model PlatformUsage {
  id            String   @id @default(uuid())
  userId        String   @unique
  workflowsRun  Int      @default(0)
  totalTokens   Int      @default(0)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
