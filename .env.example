# ==============================================================================
# Fricta Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED VARIABLES (Startup fails immediately if missing)
# ------------------------------------------------------------------------------

# Password for the Postgres container in docker-compose(.prod).yml. With
# docker-compose.prod.yml the backend's DATABASE_URL is derived from it.
POSTGRES_PASSWORD="change-me-local-only"

# Database URL for PostgreSQL persistence (local dev outside Docker)
DATABASE_URL="postgresql://fricta:fricta_dev@localhost:5432/fricta?schema=public"

# Redis URL for BullMQ and runtime job queues
REDIS_URL="redis://localhost:6379"

# AI Agent OpenRouter API Key — get yours at https://openrouter.ai
# Required when using OpenRouter (the default endpoint). Not required when
# AGENT_BASE_URL points at another OpenAI-compatible endpoint (see below).
# A free OpenRouter account is enough for the default ":free" models.
OPENROUTER_API_KEY="sk-or-v1-..."

# Clerk Authentication - Frontend (Publishable) & Backend (Publishable + Secret)
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Optional: Clerk JWT public key (PEM, Clerk Dashboard → API Keys → "JWT public
# key") for networkless session-token verification instead of fetching JWKS.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# AES-256-GCM key used to encrypt OAuth integration tokens (WorkspaceIntegration
# .accessToken/.refreshToken) at rest. Required in production — the backend
# refuses to start storing tokens without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="base64:32-random-bytes"

# ------------------------------------------------------------------------------
# OPTIONAL / CONFIGURABLE VARIABLES (Have defaults or fallbacks)
# ------------------------------------------------------------------------------

# Port the backend server binds to (default: 3001)
PORT=3001

# docker-compose.prod.yml: local port for the nginx frontend (127.0.0.1 only)
FRONTEND_PORT=8080

# AI models — FREE BY DEFAULT (Rs 0 spend policy)
# Both default to google/gemma-4-31b-it:free (text + image input, $0 on
# OpenRouter). Any id that does not end in ":free" (or the "openrouter/free"
# router) is REFUSED at startup and when an audit launches, unless
# ALLOW_PAID_MODELS=true is set. Free variants rotate; check the current list at
# https://openrouter.ai/models?max_price=0 (vision: filter input modality "image").
AGENT_MODEL="google/gemma-4-31b-it:free"
# Must accept image input (used for screenshot analysis).
AGENT_VISION_MODEL="google/gemma-4-31b-it:free"
AGENT_MAX_TOKENS=150
# Explicit opt-in to non-free models. Leave unset/false to guarantee zero spend.
ALLOW_PAID_MODELS="false"

# Optional: any OpenAI-compatible endpoint instead of OpenRouter
# (e.g. a self-hosted Ollama/vLLM/LM Studio at http://127.0.0.1:11434/v1, or the
# local test stub in apps/backend/e2e/). Requests go to <AGENT_BASE_URL>/chat/completions.
# Model ids on such endpoints rarely end in ":free", so the free-model guard
# will refuse them until you set ALLOW_PAID_MODELS=true deliberately.
# AGENT_BASE_URL="http://127.0.0.1:11434/v1"
# Optional key for AGENT_BASE_URL (falls back to OPENROUTER_API_KEY).
# AGENT_API_KEY=""

# Optional: use a preinstalled Chromium instead of Playwright's managed
# download (`npx playwright install chromium`).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="/path/to/chrome"

# Comma-separated list of allowed frontend origins for CORS (e.g. production +
# staging + local dev). Defaults to http://localhost:3000 (the Vite dev server) if unset.
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# FRONTEND ONLY VARIABLES (Required by Vite browser application build)
# ------------------------------------------------------------------------------

# Clerk Publishable Key mapped to Vite config
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# ------------------------------------------------------------------------------
# DEVELOPMENT vs PRODUCTION ONLY VARIABLES
# ------------------------------------------------------------------------------

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV="development"
