generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  projects  Project[]
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  projectName String
  websiteUrl  String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  sessions    WorkflowSession[]
}

model WorkflowSession {
  id           String   @id @default(uuid())
  projectId    String
  goal         String?
  persona      String?
  status       String   @default("PENDING")
  stepCount    Int      @default(0)
  model        String?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime @default(now())

  project      Project            @relation(fields: [projectId], references: [id])
  reports      UXReport[]
  interactions InteractionEvent[]
  screenshots  Screenshot[]
  thoughts     AgentThought[]
  actions      AgentAction[]
}

model AgentThought {
  id                String   @id @default(uuid())
  workflowSessionId String
  thought           String
  stepNumber        Int
  timestamp         DateTime @default(now())

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id])
}

model AgentAction {
  id                String   @id @default(uuid())
  workflowSessionId String
  action            String
  target            String
  value             String?
  status            String   @default("pending")
  stepNumber        Int
  errorMessage      String?
  timestamp         DateTime @default(now())

  session           WorkflowSession @relation(fields: [workflowSessionId], references: [id])
}

model InteractionEvent {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  target    String
  metadata  Json?
  timestamp DateTime @default(now())

  session   WorkflowSession @relation(fields: [sessionId], references: [id])
}

model Screenshot {
  id        String   @id @default(uuid())
  sessionId String
  path      String
  timestamp DateTime @default(now())

  session   WorkflowSession @relation(fields: [sessionId], references: [id])
}

model UXReport {
  id         String   @id @default(uuid())
  sessionId  String
  summary    String
  score      Int
  createdAt  DateTime @default(now())
  
  session    WorkflowSession @relation(fields: [sessionId], references: [id])
}
