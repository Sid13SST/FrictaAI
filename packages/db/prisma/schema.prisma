  regressionEvents RegressionEvent[]
}

model SurvivabilityForecast {
  id                        String           @id @default(uuid())
  workflowForecastId        String
  forecast                  WorkflowForecast @relation(fields: [workflowForecastId], references: [id], onDelete: Cascade)
