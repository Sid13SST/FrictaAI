# ==============================================================================
# Fricta Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED VARIABLES (Startup fails immediately if missing)
# ------------------------------------------------------------------------------

# Database URL for PostgreSQL persistence
DATABASE_URL="postgresql://fricta:fricta_dev@localhost:5432/fricta?schema=public"

# Redis URL for BullMQ and runtime job queues
REDIS_URL="redis://localhost:6379"

# AI Agent OpenRouter API Key — get yours at https://openrouter.ai
OPENROUTER_API_KEY="sk-or-v1-..."

# Clerk Authentication - Frontend (Publishable) & Backend (Publishable + Secret)
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# AES-256-GCM key used to encrypt OAuth integration tokens (WorkspaceIntegration
# .accessToken/.refreshToken) at rest. Required in production — the backend
# refuses to start storing tokens without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="base64:32-random-bytes"

# ------------------------------------------------------------------------------
# OPTIONAL / CONFIGURABLE VARIABLES (Have defaults or fallbacks)
# ------------------------------------------------------------------------------

# Port the backend server binds to (default: 3001)
PORT=3001

# AI Agent Model choices
# Options: openai/gpt-4o-mini, google/gemini-flash-1.5, meta-llama/llama-3.1-8b-instruct:free
AGENT_MODEL="openai/gpt-4o-mini"
AGENT_MAX_TOKENS=150

# Comma-separated list of allowed frontend origins for CORS (e.g. production +
# staging + local dev). Defaults to http://localhost:5173 if unset.
FRONTEND_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# FRONTEND ONLY VARIABLES (Required by Vite browser application build)
# ------------------------------------------------------------------------------

# Clerk Publishable Key mapped to Vite config
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# ------------------------------------------------------------------------------
# DEVELOPMENT vs PRODUCTION ONLY VARIABLES
# ------------------------------------------------------------------------------

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV="development"
