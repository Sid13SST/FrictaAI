}

model DivergenceEvent {
  id             String       @id @default(uuid())
  swarmSessionId String
  swarmSession   SwarmSession @relation(fields: [swarmSessionId], references: [id], onDelete: Cascade)
  stepIndex      Int
  eventType      String // "PATH_DIVERGENCE" | "COGNITIVE_SPIKE" | "ABANDONMENT"
  selector       String?
  personaTypeA   String
  actionA        String
  personaTypeB   String
  actionB        String
  details        String
  createdAt      DateTime     @default(now())
}

model WorkflowSurvivabilityMetric {
  id                     String       @id @default(uuid())
  swarmSessionId         String
  swarmSession           SwarmSession @relation(fields: [swarmSessionId], references: [id], onDelete: Cascade)
  workflowPath           String
  overallCompletionRate  Float
  averageSteps           Float
  failureClusterCount    Int
  abandonmentRiskAverage Float
  failurePoints          Json // list of selectors/elements where failure clustered
  createdAt              DateTime     @default(now())
}

model PopulationHeatmap {
  id                   String       @id @default(uuid())
  swarmSessionId       String
  swarmSession         SwarmSession @relation(fields: [swarmSessionId], references: [id], onDelete: Cascade)
  pageUrl              String
