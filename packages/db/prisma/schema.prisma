// ─── Phase 11 Part 1: Integration Infrastructure Models ──────────────────────

model WorkspaceIntegration {
  id             String     @id @default(uuid())
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider       String // "FIGMA" | "FIGJAM" | "NOTION" | "JIRA" | "LINEAR" | "GITHUB" | "PRODUCTBOARD"
  status         String     @default("DISCONNECTED") // "CONNECTED" | "DISCONNECTED" | "ERROR" | "PENDING"
  accessToken    String? // encrypted at rest
  refreshToken   String? // encrypted at rest
  tokenExpiresAt DateTime?
  providerUserId String?
  providerOrgId  String?
  scopes         String? // space-separated OAuth scopes
  metadata       Json? // provider-specific config (Jira base URL, GitHub org, etc.)
  lastSyncedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  connections IntegrationConnection[]
  events      IntegrationEvent[]
  syncJobs    SyncJob[]
  Project     Project?                @relation(fields: [projectId], references: [id])
  projectId   String?
}

model IntegrationConnection {
  id                     String               @id @default(uuid())
  workspaceIntegrationId String
  integration            WorkspaceIntegration @relation(fields: [workspaceIntegrationId], references: [id], onDelete: Cascade)
  provider               String // mirrors parent
  externalId             String // Figma fileId, Jira projectKey, Linear teamId, etc.
  externalName           String
  externalUrl            String?
  connectionType         String // "PROJECT" | "FILE" | "BOARD" | "REPO" | "TEAM"
  active                 Boolean              @default(true)
  metadata               Json?
  createdAt              DateTime             @default(now())

  replayLinks         ReplayLink[]
  evidenceAttachments EvidenceAttachment[]
  externalReferences  ExternalReference[]
}

model IntegrationEvent {
  id                     String                @id @default(uuid())
  workspaceIntegrationId String?
  integration            WorkspaceIntegration? @relation(fields: [workspaceIntegrationId], references: [id], onDelete: SetNull)
  workspaceId            String?
  workspace              Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider               String
  direction              String // "INCOMING" | "OUTGOING"
  eventType              String // e.g. "REPLAY_LINKED", "TICKET_CREATED", "WEBHOOK_RECEIVED"
  status                 String                @default("PENDING") // "PENDING" | "PROCESSED" | "FAILED"
  payload                Json?
  errorMessage           String?
  retryCount             Int                   @default(0)
  deduplicationKey       String?               @unique
  createdAt              DateTime              @default(now())
  processedAt            DateTime?
}

model ReplayLink {
  id                   String                 @id @default(uuid())
  projectId            String
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId         String?
  connection           IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  workflowSessionId    String?
  provider             String // "FIGMA" | "JIRA" | "GITHUB" | etc.
  externalResourceId   String // frame nodeId, issue key, PR number, etc.
  externalResourceUrl  String?
  externalResourceName String?
  linkType             String // "FRAME" | "ISSUE" | "PR" | "PAGE" | "FEATURE" | "COMMIT"
  uxFindingId          String? // optional direct finding reference
  evidenceSummary      String? // short cognitive/survivability context
  createdAt            DateTime               @default(now())
}

model EvidenceAttachment {
  id             String                 @id @default(uuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider       String
  externalId     String // the ticket / frame / PR ID on the external system
  attachmentType String // "SCREENSHOT" | "FINDING" | "COGNITIVE_SIGNAL" | "SURVIVABILITY" | "REPLAY_CLIP"
  title          String
  description    String?
  evidenceUrl    String? // local screenshot path or replay URL
  severity       String? // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  metadata       Json?
  createdAt      DateTime               @default(now())
}

model ExternalReference {
  id            String                @id @default(uuid())
  connectionId  String
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider      String
  refType       String // "ISSUE" | "PR" | "COMMIT" | "FRAME" | "PAGE" | "FEATURE"
  externalId    String
  externalKey   String? // human-readable: "JIRA-123", "GH-PR-456", "figma:nodeId"
  externalUrl   String?
  title         String?
  status        String? // mirrors external system status
  replayLineage Json? // serialized replay context for full traceability
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model SyncJob {
  id                     String               @id @default(uuid())
  workspaceIntegrationId String
  integration            WorkspaceIntegration @relation(fields: [workspaceIntegrationId], references: [id], onDelete: Cascade)
  provider               String
  jobType                String // "REPLAY_LINK" | "EVIDENCE_PUSH" | "TICKET_CREATE" | "WEBHOOK_PROCESS"
  status                 String               @default("QUEUED") // "QUEUED" | "RUNNING" | "COMPLETED" | "FAILED" | "DEAD_LETTER"
  payload                Json?
  result                 Json?
  errorMessage           String?
  retryCount             Int                  @default(0)
  maxRetries             Int                  @default(3)
  scheduledAt            DateTime             @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime             @default(now())
}

model IntegrationAuditEvent {
  id           String     @id @default(uuid())
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider     String
  action       String // "CONNECT" | "DISCONNECT" | "TOKEN_REFRESH" | "REPLAY_LINKED" | "EVIDENCE_ATTACHED" | "TICKET_CREATED" | "WEBHOOK_RECEIVED"
  description  String
  resourceId   String? // affected external resource ID
  policyPassed Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

// ─── Phase 11 Part 2: Engineering Workflow Integration Models ──────────────────

model DeploymentRun {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitHash         String
  branch             String
  environment        String // "production" | "staging" | "preview"
  deploymentUrl      String?
  status             String   @default("PENDING") // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED"
  provider           String // "VERCEL" | "NETLIFY" | "GITHUB_ACTIONS" | "GITLAB_CI"
  survivabilityScore Float?
  riskLevel          String? // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  replayExecutions  ReplayExecution[]
  previews          PreviewEnvironment[]
  prIntelligences   PullRequestIntelligence[]
  regressions       RegressionAnalysis[]
  riskSignals       DeploymentRiskSignal[]
  buildCorrelations BuildCorrelation[]
  timelineEvents    ReleaseTimelineEvent[]
}

model ReplayExecution {
  id                String           @id @default(uuid())
  deploymentRunId   String
  deploymentRun     DeploymentRun    @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  workflowSessionId String?
  workflowSession   WorkflowSession? @relation(fields: [workflowSessionId], references: [id], onDelete: SetNull)
  workflowPath      String
  status            String           @default("PENDING") // "PENDING" | "RUNNING" | "COMPLETED" | "FAILED"
  survivabilityRate Float?
  cognitiveLoad     Float?
  frictionScore     Float?
  stepsCompleted    Int?
  errorMessage      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model PreviewEnvironment {
  id              String        @id @default(uuid())
  deploymentRunId String
  deploymentRun   DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  provider        String // "VERCEL" | "NETLIFY"
  url             String
  branch          String
  prNumber        String?
  isTemporary     Boolean       @default(true)
  status          String        @default("ACTIVE") // "ACTIVE" | "TEARDOWN" | "INACTIVE"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PullRequestIntelligence {
  id                 String        @id @default(uuid())
  deploymentRunId    String
  deploymentRun      DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  prNumber           String
  prTitle            String
  sourceBranch       String
  targetBranch       String
  uxRegressionCount  Int           @default(0)
  cognitiveDrift     Float         @default(0.0)
  survivabilityDelta Float         @default(0.0)
  riskScore          Float         @default(0.0)
  summary            String?
  status             String        @default("PENDING") // "PENDING" | "COMPLETED" | "FAILED"
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model RegressionAnalysis {
  id              String        @id @default(uuid())
  deploymentRunId String
  deploymentRun   DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  workflowPath    String
  metricName      String // "SUCCESS_RATE" | "COGNITIVE_LOAD" | "FRICTION" | "STEPS"
  baseValue       Float
  currentValue    Float
  delta           Float
  severity        String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  explanation     String
  escalated       Boolean       @default(false)
  createdAt       DateTime      @default(now())
}

model DeploymentRiskSignal {
  id              String        @id @default(uuid())
  deploymentRunId String
  deploymentRun   DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  riskType        String // "CTA_BROKEN" | "COGNITIVE_SPIKE" | "ONBOARDING_REGRESSION" | "NAV_LOOP"
  severity        String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  description     String
  targetSelector  String?
  evidenceUrl     String?
  createdAt       DateTime      @default(now())
}

model BuildCorrelation {
  id              String        @id @default(uuid())
  deploymentRunId String
  deploymentRun   DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  buildId         String
  jobId           String?
  commitMessage   String?
  author          String?
  duration        Int?
  logUrl          String?
  createdAt       DateTime      @default(now())
}

model ReleaseTimelineEvent {
  id              String        @id @default(uuid())
  deploymentRunId String
  deploymentRun   DeploymentRun @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  eventType       String // "COMMIT" | "BUILD_START" | "BUILD_SUCCESS" | "DEPLOY" | "REPLAY_START" | "REPLAY_SUCCESS" | "PR_COMMENTED" | "REGRESSION_DETECTED"
  eventTitle      String
  description     String
  timestamp       DateTime      @default(now())
}

// ─── Phase 11 Part 3: Operational Collaboration Models ───────────────────────

model SharedReplaySession {
  id                String          @id @default(uuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowSessionId String
  workflowSession   WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
  shareToken        String          @unique
  sharedWithEmail   String?
  notes             String?
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
}

model InvestigationThread {
  id                String           @id @default(uuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  workflowSessionId String?
  workflowSession   WorkflowSession? @relation(fields: [workflowSessionId], references: [id], onDelete: SetNull)
  uxFindingId       String?
  status            String           @default("ACTIVE") // "ACTIVE" | "RESOLVED"
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  annotations ReplayAnnotation[]
  mentions    TeamMentionEvent[]
}

model ReplayAnnotation {
  id        String              @id @default(uuid())
  threadId  String
  thread    InvestigationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  stepIndex Int
  author    String
  content   String
  x         Float?
  y         Float?
  timestamp DateTime            @default(now())
}

model CollaborationEvent {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomType   String // "INVESTIGATION" | "REPLAY_SHARING"
  roomId     String
  userEmail  String
  actionType String // "JOINED" | "SCRUBBED" | "ANNOTATED" | "ESCALATED"
  payload    Json?
  timestamp  DateTime @default(now())
}

model OperationalAlert {
  id                String           @id @default(uuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  alertType         String // "SURVIVABILITY_DROP" | "COGNITIVE_OVERLOAD" | "REGRESSION"
  severity          String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  message           String
  workflowSessionId String?
  workflowSession   WorkflowSession? @relation(fields: [workflowSessionId], references: [id], onDelete: SetNull)
  resolved          Boolean          @default(false)
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())

  escalations AlertEscalation[]
}

model AlertEscalation {
  id           String           @id @default(uuid())
  alertId      String
  alert        OperationalAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel      String // "SLACK" | "DISCORD" | "TEAMS" | "EMAIL"
  recipient    String // channel id, webhook, or email
  status       String // "SENT" | "FAILED"
  errorMessage String?
  sentAt       DateTime         @default(now())
}

model DigestSubscription {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  frequency String // "DAILY" | "WEEKLY"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TeamMentionEvent {
  id            String              @id @default(uuid())
  threadId      String
  thread        InvestigationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mentionedUser String
  author        String
  content       String
  read          Boolean             @default(false)
  createdAt     DateTime            @default(now())
}
