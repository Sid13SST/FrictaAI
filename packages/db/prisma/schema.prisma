  divergenceEvents     DivergenceEvent[]
}

model PersonaExecution {
  id                String           @id @default(uuid())
  swarmSessionId    String
  swarmSession      SwarmSession     @relation(fields: [swarmSessionId], references: [id], onDelete: Cascade)
  personaType       String // "Beginner Teacher", "Distracted Student", etc.
  workflowSessionId String?
  workflowSession   WorkflowSession? @relation(fields: [workflowSessionId], references: [id], onDelete: SetNull)
  status            String           @default("RUNNING") // RUNNING, COMPLETED, FAILED
  completionRate    Float            @default(0.0) // 0 or 1
  durationMs        Int              @default(0)
  frictionScore     Float            @default(0.0)
  stepsCompleted    Int              @default(0)
  createdAt         DateTime         @default(now())

  replays SwarmReplayEvent[]
}

model PersonaComparison {
  id              String       @id @default(uuid())
  swarmSessionId  String
  swarmSession    SwarmSession @relation(fields: [swarmSessionId], references: [id], onDelete: Cascade)
  personaA        String
  personaB        String
  similarityScore Float
  divergenceNotes String
  pathVariance    Float
  cognitiveDelta  Float
