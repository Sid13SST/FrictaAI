generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                        @id @default(uuid())
  email                  String                        @unique
  name                   String?
  createdAt              DateTime                      @default(now())
  projects               Project[]
  platformUsage          PlatformUsage?
  memberships            WorkspaceMember[]
  assignedReviews        InvestigationReview[]
  annotations            Annotation[]
  comments               EvidenceComment[]
  shares                 SharedLink[]
  activities             ActivityEvent[]
  sentInvites            WorkspaceInvite[]             @relation("Inviter")
  sharedInvestigations   SharedInvestigation[]
  investigationComments  InvestigationComment[]
  workspaceActivities    WorkspaceActivity[]
  securityEvents         WorkspaceSecurityEvent[]
  reportsCreated         ExecutiveReport[]
  exportsCreated         ReportExport[]
  sharesCreated          SharedReport[]
  distributionsSent      ReportDistributionEvent[]
  auditEvents            AuditEvent[]
  securityEventsLog      SecurityEvent[]
  replayAuditLogs        ReplayAuditLog[]
  investigationAuditLogs InvestigationAuditLog[]
  governancePolicyEvents GovernancePolicyEvent[]
  accessTraceRecords     AccessTraceRecord[]
  securityAlerts         WorkspaceSecurityAlert[]
  optimizationApprovals  OptimizationApproval[]
  optimizationRollbacks  OptimizationRollback[]
  governanceEvents       OptimizationGovernanceEvent[]
  integrationAuditEvents IntegrationAuditEvent[]
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  projectName String
  websiteUrl  String
  createdAt   DateTime @default(now())

  user                      User                        @relation(fields: [userId], references: [id])
  workspace                 Workspace?                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions                  WorkflowSession[]
  historicalPatterns        HistoricalPattern[]
  workflowRegressions       WorkflowRegression[]
  personaTrends             PersonaTrend[]
  organizationalInsights    OrganizationalInsight[]
  historicalCorrelations    HistoricalCorrelation[]
  adaptiveSignalProfiles    AdaptiveSignalProfile[]
  annotations               Annotation[]
  shares                    SharedLink[]
  simulationProfiles        SimulationProfile[]
  swarmSessions             SwarmSession[]
  workflowForecasts         WorkflowForecast[]
  historicalBaselines       HistoricalBaseline[]
  regressionEvents          RegressionEvent[]
  workspaceProjects         WorkspaceProject[]
  executiveReports          ExecutiveReport[]
  CrossSessionPattern       CrossSessionPattern[]
  HistoricalRegression      HistoricalRegression[]
  PersonaEvolution          PersonaEvolution[]
  WorkflowStabilityHistory  WorkflowStabilityHistory[]
  LongitudinalSignal        LongitudinalSignal[]
  SessionCorrelation        SessionCorrelation[]
  UXMemorySnapshot          UXMemorySnapshot[]
  uxFailurePredictions      UXFailurePrediction[]
  cognitiveRiskSignals      CognitiveRiskSignal[]
  workflowRiskScores        WorkflowRiskScore[]
  predictiveMemorySignals   PredictiveMemorySignal[]
  redesignRecommendations   RedesignRecommendation[]
  uxOptimizationSuggestions UXOptimizationSuggestion[]
  cognitiveRemediations     CognitiveRemediation[]
  workflowOptimizations     WorkflowOptimization[]
  optimizationMemorySignals OptimizationMemorySignal[]
  autonomousRuns            AutonomousOptimizationRun[]
  adaptationRules           AdaptationRule[]
  integrations              WorkspaceIntegration[]
  replayLinks               ReplayLink[]
  evidenceAttachments       EvidenceAttachment[]
  deploymentRuns            DeploymentRun[]
  sharedReplays             SharedReplaySession[]
  threads                   InvestigationThread[]
  collaborationLogs         CollaborationEvent[]
  operationalAlerts         OperationalAlert[]
  digestSubs                DigestSubscription[]
}

model WorkflowSession {
  id         String    @id @default(uuid())
  projectId  String
  goal       String?
  persona    String?
  status     String    @default("PENDING")
  queueJobId String?
  stepCount  Int       @default(0)
  model      String?
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())

  project                  Project                     @relation(fields: [projectId], references: [id])
  reports                  UXReport[]
  interactions             InteractionEvent[]
  screenshots              Screenshot[]
  workflowScreenshots      WorkflowScreenshot[]
  timelineEvents           ScreenshotTimelineEvent[]
  thoughts                 AgentThought[]
  actions                  AgentAction[]
  signals                  UXSignal[]
  recommendations          UXRecommendation[]
  scores                   UXScore[]
  metrics                  WorkflowMetrics?
  visualFindings           VisualFinding[]
  visualScores             VisualScore[]
  uxFindings               UXFinding[]
  cognitiveSignals         CognitiveSignal[]
  orchestrationSessions    OrchestrationSession[]
  reviews                  InvestigationReview[]
  simulationDecisions      BehavioralDecision[]
  simulationPaths          ExplorationPath[]
  hesitationSignals        HesitationSignal[]
  confidenceEvents         NavigationConfidenceEvent[]
  frictionReactions        FrictionReaction[]
  behavioralReplayEvents   BehavioralReplayEvent[]
  cognitiveStates          CognitiveState[]
  confidenceSignals        ConfidenceSignal[]
  attentionEvents          AttentionEvent[]
  expectationMismatches    ExpectationMismatch[]
  decisionComplexityEvents DecisionComplexityEvent[]
  abandonmentRiskSignals   AbandonmentRiskSignal[]
  cognitiveTimelineEvents  CognitiveTimelineEvent[]
  personaExecutions        PersonaExecution[]
  sharedInvestigations     SharedInvestigation[]
  replayAccessScopes       ReplayAccessScope[]
  ReplayAuditLog           ReplayAuditLog[]
  replayExecutions         ReplayExecution[]
  sharedSessions           SharedReplaySession[]
  investigationThreads     InvestigationThread[]
  operationalAlerts        OperationalAlert[]
}

model AgentThought {
  id                String   @id @default(uuid())
  workflowSessionId String
  thought           String
  stepNumber        Int
  timestamp         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id])
}

model AgentAction {
  id                String   @id @default(uuid())
  workflowSessionId String
  action            String
  target            String
  value             String?
  status            String   @default("pending")
  stepNumber        Int
  errorMessage      String?
  timestamp         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id])
}

model InteractionEvent {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  target    String
  metadata  Json?
  timestamp DateTime @default(now())

  session WorkflowSession @relation(fields: [sessionId], references: [id])
}

model Screenshot {
  id        String   @id @default(uuid())
  sessionId String
  path      String
  timestamp DateTime @default(now())

  session WorkflowSession @relation(fields: [sessionId], references: [id])
}

model WorkflowScreenshot {
  id                String   @id @default(uuid())
  workflowSessionId String
  screenshotType    String // "step" | "error" | "full" | "viewport"
  filePath          String
  thumbnailPath     String
  timestamp         DateTime @default(now())
  stepIndex         Int
  pageUrl           String
  viewportWidth     Int
  viewportHeight    Int
  actionContext     String?
  fileSize          Int
  metadata          Json?

  session        WorkflowSession           @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
  timelineEvents ScreenshotTimelineEvent[]
  visualFindings VisualFinding[]
}

model ScreenshotTimelineEvent {
  id                String   @id @default(uuid())
  workflowSessionId String
  screenshotId      String
  actionId          String?
  thoughtId         String?
  timestamp         DateTime @default(now())
  eventType         String // "action" | "thought" | "signal" | "error"

  session    WorkflowSession    @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
  screenshot WorkflowScreenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
}

model UXReport {
  id        String   @id @default(uuid())
  sessionId String
  summary   String
  score     Int
  createdAt DateTime @default(now())

  session WorkflowSession @relation(fields: [sessionId], references: [id])
}

model UXSignal {
  id                String   @id @default(uuid())
  workflowSessionId String
  signalType        String
  severity          String
  metadata          Json?
  timestamp         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model UXRecommendation {
  id                String @id @default(uuid())
  workflowSessionId String
  title             String
  description       String
  evidence          String
  severity          String

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model UXScore {
  id                String @id @default(uuid())
  workflowSessionId String
  clarityScore      Float
  efficiencyScore   Float
  smoothnessScore   Float
  overallScore      Float

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model WorkflowMetrics {
  id                String @id @default(uuid())
  workflowSessionId String @unique
  duration          Int?
  retryCount        Int    @default(0)
  tokenUsage        Int    @default(0)
  completionStatus  String

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model PlatformUsage {
  id           String   @id @default(uuid())
  userId       String   @unique
  workflowsRun Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VisualFinding {
  id                String   @id @default(uuid())
  workflowSessionId String
  screenshotId      String
  findingType       String
  severity          String
  title             String
  description       String
  boundingBoxes     Json // list of { x, y, width, height, label }
  metadata          Json
  timestamp         DateTime @default(now())

  session    WorkflowSession    @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
  screenshot WorkflowScreenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)
}

model VisualScore {
  id                   String   @id @default(uuid())
  workflowSessionId    String
  clarityScore         Float
  discoverabilityScore Float
  layoutBalanceScore   Float
  navigationScore      Float
  overallScore         Float
  createdAt            DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model UXFinding {
  id                String   @id @default(uuid())
  workflowSessionId String
  findingType       String // e.g., "HESITATION", "NAVIGATION_LOOP", "CTA_AMBIGUITY", "ONBOARDING_FRICTION", "FORM_FRICTION", "COMPLEXITY", "IA_CONFUSION"
  severity          String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  personaType       String // "BEGINNER" | "POWER_USER" | "FIRST_TIME_USER" | "DISTRACTED_USER" | "STANDARD"
  title             String
  description       String
  evidence          String // Evidence details/steps where it occurred
  recommendation    String // Actionable UX improvement
  timestamp         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model CognitiveSignal {
  id                String   @id @default(uuid())
  workflowSessionId String
  signalType        String // "COGNITIVE_OVERLOAD" | "DECISION_FATIGUE" | "WORKFLOW_DENSITY" | "DISCOVERABILITY_FRICTION" | "BRANCHING_DEPTH"
  intensity         Float // Value from 0.0 to 1.0 representing signal intensity
  metadata          Json?
  timestamp         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model PersonaProfile {
  id                String @id @default(uuid())
  name              String // e.g., "Beginner Teacher", "Power User", "First-Time User"
  description       String
  traits            Json // List of traits
  behaviorModifiers Json // Numerical thresholds/weights
}

model OrchestrationSession {
  id                String    @id @default(uuid())
  workflowSessionId String
  status            String    @default("PENDING")
  startedAt         DateTime?
  completedAt       DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())

  workflowSession       WorkflowSession        @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
  agentExecutions       AgentExecution[]
  delegationEvents      DelegationEvent[]
  sharedContextEvents   SharedContextEvent[]
  sharedMemoryEvents    SharedMemoryEvent[]
  correlatedFindings    CorrelatedFinding[]
  collaborativeInsights CollaborativeInsight[]
  memorySnapshots       MemorySnapshot[]
}

model AgentExecution {
  id                     String    @id @default(uuid())
  orchestrationSessionId String
  agentType              String
  status                 String    @default("IDLE") // IDLE, QUEUED, RUNNING, WAITING, COMPLETED, FAILED, CANCELLED
  task                   String
  result                 Json?
  startedAt              DateTime?
  completedAt            DateTime?
  metadata               Json?
  createdAt              DateTime  @default(now())

  orchestrationSession OrchestrationSession  @relation(fields: [orchestrationSessionId], references: [id], onDelete: Cascade)
  findings             AgentFinding[]
  signals              AgentSignal[]
  reasoningTraces      AgentReasoningTrace[]
}

model DelegationEvent {
  id                     String   @id @default(uuid())
  orchestrationSessionId String
  fromAgent              String
  toAgent                String
  eventType              String
  payload                Json?
  timestamp              DateTime @default(now())

  orchestrationSession OrchestrationSession @relation(fields: [orchestrationSessionId], references: [id], onDelete: Cascade)
}

model SharedContextEvent {
  id                     String   @id @default(uuid())
  orchestrationSessionId String
  eventType              String
  payload                Json?
  timestamp              DateTime @default(now())

  orchestrationSession OrchestrationSession @relation(fields: [orchestrationSessionId], references: [id], onDelete: Cascade)
}

model AgentFinding {
  id                 String   @id @default(uuid())
  agentExecutionId   String
  agentType          String
  findingType        String
  severity           String
  title              String
  description        String
  evidence           String
  correlatedFindings Json?
  timestamp          DateTime @default(now())

  agentExecution AgentExecution @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
}

model AgentSignal {
  id               String   @id @default(uuid())
  agentExecutionId String
  signalType       String
  intensity        Float
  metadata         Json?
  timestamp        DateTime @default(now())

  agentExecution AgentExecution @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
}

model AgentReasoningTrace {
  id               String   @id @default(uuid())
  agentExecutionId String
  stepType         String
  summary          String
  evidence         String?
  timestamp        DateTime @default(now())

  agentExecution AgentExecution @relation(fields: [agentExecutionId], references: [id], onDelete: Cascade)
}

model SharedMemoryEvent {
  id                     String   @id @default(uuid())
  orchestrationSessionId String
  eventType              String
  sourceAgent            String
  payload                Json
  timestamp              DateTime @default(now())

  orchestrationSession OrchestrationSession @relation(fields: [orchestrationSessionId], references: [id], onDelete: Cascade)
}

model CorrelatedFinding {
  id                     String   @id @default(uuid())
  orchestrationSessionId String
  findingIds             Json
  correlationType        String
  summary                String
  confidence             Float
  metadata               Json?
  timestamp              DateTime @default(now())

  orchestrationSession OrchestrationSession @relation(fields: [orchestrationSessionId], references: [id], onDelete: Cascade)
}

model CollaborativeInsight {
  id                     String   @id @default(uuid())
  orchestrationSessionId String
  title                  String
  summary                String
  supportingEvidence     String
  severity               String
  confidence             Float
  timestamp              DateTime @default(now())

  orchestrationSession OrchestrationSession @relation(fields: [orchestrationSessionId], references: [id], onDelete: Cascade)
}

model MemorySnapshot {
  id                     String   @id @default(uuid())
  orchestrationSessionId String
  snapshotType           String
  payload                Json
  createdAt              DateTime @default(now())

  orchestrationSession OrchestrationSession @relation(fields: [orchestrationSessionId], references: [id], onDelete: Cascade)
}

model HistoricalPattern {
  id               String   @id @default(uuid())
  projectId        String
  patternType      String // "NAVIGATION_CONFUSION" | "ONBOARDING_FRICTION" | "CTA_DISCOVERABILITY" | etc.
  name             String
  description      String
  severity         String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  confidence       Float
  frequency        Int // How many times this pattern has been detected
  affectedSessions Json // List of session IDs (JSON array of strings)
  evidenceSummary  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WorkflowRegression {
  id                String   @id @default(uuid())
  projectId         String
  workflowPath      String // e.g., "/onboarding"
  metricName        String // "COGNITIVE_LOAD" | "STEPS_TO_COMPLETE" | "SUCCESS_RATE" | etc.
  baseValue         Float
  currentValue      Float
  deltaPercentage   Float
  severity          String // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  explanation       String
  evidenceSessionId String // The session where the regression was caught
  baseSessionId     String // The baseline session compared against
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PersonaTrend {
  id             String   @id @default(uuid())
  projectId      String
  personaType    String // "BEGINNER" | "POWER_USER" | etc.
  metricName     String // "SUCCESS_RATE" | "DECISION_DELAY" | etc.
  trendDirection String // "IMPROVING" | "STABLE" | "DEGRADING"
  averageValue   Float
  observation    String
  sampleCount    Int
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model OrganizationalInsight {
  id              String   @id @default(uuid())
  projectId       String
  title           String
  summary         String
  insightCategory String // "STABILITY" | "IMPROVEMENT" | "RECURRING_DEFECT" | etc.
  metrics         Json? // Structured data/charts
  impactScore     Float // 0.0 to 1.0 representing severity/impact
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model HistoricalCorrelation {
  id                   String   @id @default(uuid())
  projectId            String
  findingType          String
  summary              String
  sessionCount         Int
  correlatedFindingIds Json // List of finding IDs across different sessions
  confidence           Float
  createdAt            DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AdaptiveSignalProfile {
  id             String   @id @default(uuid())
  projectId      String
  agentType      String // e.g., "ONBOARDING_AGENT"
  targetPriority String // "HIGH" | "CRITICAL" | "NORMAL"
  reasonTrigger  String // "Historical onboarding regression detected on step X"
  isActive       Boolean  @default(true)
  metadata       Json? // prioritization overrides, parameters, thresholds
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]
  members    WorkspaceMember[]
  teams      Team[]
}

model Workspace {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                    WorkspaceMember[]
  projects                   Project[]
  invites                    WorkspaceInvite[]
  sharedInvestigations       SharedInvestigation[]
  workspaceProjects          WorkspaceProject[]
  workspaceActivities        WorkspaceActivity[]
  workspacePolicies          WorkspacePolicy[]
  investigationAccesses      InvestigationAccess[]
  replayAccessScopes         ReplayAccessScope[]
  sharedAccessGrants         SharedAccessGrant[]
  securityEvents             WorkspaceSecurityEvent[]
  executiveReports           ExecutiveReport[]
  reportTemplates            ReportTemplate[]
  workspaceInsightDigests    WorkspaceInsightDigest[]
  auditEvents                AuditEvent[]
  securityEventsLog          SecurityEvent[]
  replayAuditLogs            ReplayAuditLog[]
  investigationAuditLogs     InvestigationAuditLog[]
  governancePolicyEvents     GovernancePolicyEvent[]
  complianceRetentionRecords ComplianceRetentionRecord[]
  accessTraceRecords         AccessTraceRecord[]
  securityAlerts             WorkspaceSecurityAlert[]
  CrossSessionPattern        CrossSessionPattern[]
  HistoricalRegression       HistoricalRegression[]
  OrganizationalTrend        OrganizationalTrend[]
  PersonaEvolution           PersonaEvolution[]
  WorkflowStabilityHistory   WorkflowStabilityHistory[]
  LongitudinalSignal         LongitudinalSignal[]
  SessionCorrelation         SessionCorrelation[]
  UXMemorySnapshot           UXMemorySnapshot[]
  uxFailurePredictions       UXFailurePrediction[]
  cognitiveRiskSignals       CognitiveRiskSignal[]
  workflowRiskScores         WorkflowRiskScore[]
  predictiveMemorySignals    PredictiveMemorySignal[]
  redesignRecommendations    RedesignRecommendation[]
  uxOptimizationSuggestions  UXOptimizationSuggestion[]
  cognitiveRemediations      CognitiveRemediation[]
  workflowOptimizations      WorkflowOptimization[]
  optimizationMemorySignals  OptimizationMemorySignal[]
  autonomousRuns             AutonomousOptimizationRun[]
  adaptationRules            AdaptationRule[]
  governanceEvents           OptimizationGovernanceEvent[]
  integrations               WorkspaceIntegration[]
  integrationEvents          IntegrationEvent[]
  integrationAuditEvents     IntegrationAuditEvent[]
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
}

model WorkspaceMember {
  id             String   @id @default(uuid())
  organizationId String
  workspaceId    String?
  teamId         String?
  userId         String
  role           String // "OWNER" | "ADMIN" | "UX_LEAD" | "INVESTIGATOR" | "REVIEWER" | "VIEWER"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions     PermissionGrant[]
  workspaceRoleId String?
  workspaceRole   WorkspaceRole?    @relation(fields: [workspaceRoleId], references: [id], onDelete: SetNull)
}

model InvestigationReview {
  id                String   @id @default(uuid())
  workflowSessionId String
  assignedToId      String? // User ID of the assignee
  status            String // "PENDING" | "UNDER_REVIEW" | "APPROVED" | "REJECTED" | "RESOLVED"
  approvalNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workflowSession WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
  assignedTo      User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
}

model Annotation {
  id          String   @id @default(uuid())
  projectId   String
  targetType  String // "SCREENSHOT" | "TIMELINE_EVENT" | "FINDING" | "TREND" | "HEATMAP"
  targetId    String // ID of the target resource
  title       String?
  content     String
  severity    String? // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL" (if mapping a friction overlay)
  resolved    Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  comments  EvidenceComment[]
}

model EvidenceComment {
  id           String   @id @default(uuid())
  annotationId String
  content      String
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  annotation Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model SharedLink {
  id          String    @id @default(uuid())
  projectId   String
  targetType  String // "INVESTIGATION" | "REPORT" | "REPLAY" | "SUMMARY"
  targetId    String
  token       String    @unique
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id          String   @id @default(uuid())
  projectId   String?
  workspaceId String?
  userId      String
  actionType  String // "INVESTIGATION_RUN" | "ANNOTATION_CREATE" | "REVIEW_UPDATE" | "PERMISSION_GRANT" | "REPORT_EXPORT"
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PermissionGrant {
  id          String   @id @default(uuid())
  workspaceId String?
  projectId   String?
  memberId    String // WorkspaceMember ID
  action      String // "READ_INVESTIGATION" | "WRITE_ANNOTATION" | "EXPORT_REPORT" | etc.
  isAllowed   Boolean  @default(true)
  createdAt   DateTime @default(now())

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model SimulationProfile {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  personaType String // "BEGINNER" | "POWER_USER" | "FIRST_TIME_USER" | "DISTRACTED_USER"
  description String?
  traits      Json // Configuration weights for confidence, patience, reading depth, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisions BehavioralDecision[]
  paths     ExplorationPath[]
  replays   BehavioralReplayEvent[]
}

model BehavioralDecision {
  id                  String   @id @default(uuid())
  simulationProfileId String
  workflowSessionId   String?
  stepIndex           Int
  actionType          String // "CLICK" | "HOVER" | "SCAN" | "BACKTRACK" | "INPUT" | "PAUSE"
  targetElement       String // Selector or coordinate description
  decisionReason      String // Why this action was chosen (intent-driven)
  confidenceBefore    Float // Confidence metric before action (0.0 to 1.0)
  confidenceAfter     Float // Confidence metric after action (0.0 to 1.0)
  latencyMs           Int // Simulated pacing duration
  createdAt           DateTime @default(now())

  profile SimulationProfile @relation(fields: [simulationProfileId], references: [id], onDelete: Cascade)
  session WorkflowSession?  @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model ExplorationPath {
  id                  String   @id @default(uuid())
  simulationProfileId String
  workflowSessionId   String?
  steps               Json // List of { stepIndex, url, action, duration }
  isSuccess           Boolean  @default(false)
  totalFrictionScore  Float // Aggregated friction during this run
  createdAt           DateTime @default(now())

  profile SimulationProfile @relation(fields: [simulationProfileId], references: [id], onDelete: Cascade)
  session WorkflowSession?  @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model HesitationSignal {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  signalType        String // "HOVER_HESITATION" | "REPEATED_SCANNING" | "DELAYED_CLICKING" | "CURSOR_DRIFT"
  targetElement     String?
  durationMs        Int
  severity          String // "LOW" | "MEDIUM" | "HIGH"
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model NavigationConfidenceEvent {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  confidenceValue   Float // 0.0 to 1.0
  contextualDetails String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model FrictionReaction {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  reactionType      String // "ABANDONMENT_RISK" | "EXPLORATION_SLOWDOWN" | "RETRY_HESITATION"
  triggerSource     String // e.g. "CTA_AMBIGUITY"
  intensity         Float // 0.0 to 1.0
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model BehavioralReplayEvent {
  id                  String   @id @default(uuid())
  simulationProfileId String
  workflowSessionId   String
  stepIndex           Int
  eventType           String // "HOVER" | "CLICK" | "INPUT" | "SCAN" | "SCROLL" | "BACKTRACK"
  coordinates         Json? // { x, y } target or path coordinates
  targetSelector      String?
  durationMs          Int
  metaData            Json? // Pacing/decision metadata
  createdAt           DateTime @default(now())

  profile SimulationProfile @relation(fields: [simulationProfileId], references: [id], onDelete: Cascade)
  session WorkflowSession   @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model CognitiveState {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  cognitiveLoad     Float // 0.0 to 1.0 (overall load)
  mentalEffort      Float // 0.0 to 1.0 (interaction-driven)
  informationLoad   Float // 0.0 to 1.0 (visual/information density)
  interactionLoad   Float // 0.0 to 1.0 (clutter/input)
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model ConfidenceSignal {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  confidenceScore   Float // 0.0 to 1.0
  certaintyLevel    String // "HIGH" | "MEDIUM" | "LOW"
  targetElement     String?
  evidenceSource    String // e.g., "CLICK_CERTAINTY", "CURSOR_DRIFT", "REPEATED_SCANNING", "BACKTRACKING"
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model AttentionEvent {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  targetElement     String?
  visibilityWeight  Float // 0.0 to 1.0 (CTA prominence / visual dominance)
  focusHeat         Float // 0.0 to 1.0 (computed visual focus weight)
  overloadDetected  Boolean  @default(false)
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model ExpectationMismatch {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  expectedAction    String // E.g., "Navbar Settings"
  actualAction      String // E.g., "Hidden Settings in Avatar Dropdown"
  mismatchSeverity  String // "LOW" | "MEDIUM" | "HIGH"
  mismatchCategory  String // "NAV_MISPLACEMENT", "CTA_AMBIGUITY", "UI_CONVENTION_BREAK", "PROGRESS_DESYNC"
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model DecisionComplexityEvent {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  choiceCount       Int // Number of interactable choices
  ambiguityScore    Float // 0.0 to 1.0 (lack of focal CTA)
  complexityLevel   String // "LOW" | "MEDIUM" | "HIGH"
  nextActionClarity Float // 0.0 to 1.0
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model AbandonmentRiskSignal {
  id                  String   @id @default(uuid())
  workflowSessionId   String
  stepIndex           Int
  riskProbability     Float // 0.0 to 1.0 (predictive likelihood of session abandon)
  triggerSource       String // E.g., "CONFIDENCE_DEGRADATION", "EXPLORATION_FATIGUE", "RETRY_FREQUENCY"
  frictionAccumulated Float // 0.0 to 1.0
  description         String
  createdAt           DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model CognitiveTimelineEvent {
  id                String   @id @default(uuid())
  workflowSessionId String
  stepIndex         Int
  eventType         String // "COGNITIVE_LOAD_SPIKE" | "EXPECTATION_FAIL" | "CONFIDENCE_DROP" | "ATTENTION_SHIFT" | "RISK_ESCALATION"
  intensity         Float // 0.0 to 1.0
  associatedId      String? // Polymorphic reference to the specific model ID
  description       String
  createdAt         DateTime @default(now())

  session WorkflowSession @relation(fields: [workflowSessionId], references: [id], onDelete: Cascade)
}

model SwarmSession {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  startUrl  String
  goal      String
  status    String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  executions           PersonaExecution[]
  comparisons          PersonaComparison[]
  survivabilityMetrics WorkflowSurvivabilityMetric[]
